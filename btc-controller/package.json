{
  "name": "btc-module",
  "version": "1.0.0",
  "description": "Enterprise-grade Bitcoin wallet infrastructure",
  "main": "src/index.ts",
  "scripts": {
    "test": "mocha -r ts-node/register --timeout 15000 test/*.js",
    "coverage": "c8 --reporter=text --reporter=html mocha -r ts-node/register --timeout 15000 test/*.js",
    "build": "tsc",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "nyc": {
    "extension": [
      ".ts"
    ],
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "**/*.d.ts",
      "src/types/**"
    ],
    "reporter": [
      "text",
      "html"
    ],
    "all": true
  },
  "dependencies": {
    "@bitcoinerlab/secp256k1": "^1.0.5",
    "axios": "^1.6.0",
    "bip32": "^4.0.0",
    "bip39": "^3.1.0",
    "bitcoinjs-lib": "^6.1.5",
    "bitcoinjs-message": "^2.2.0",
    "ecpair": "^2.1.0",
    "obs-store": "^4.0.3",
    "satoshi-bitcoin": "^1.0.5"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "c8": "^11.0.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "mocha": "^10.2.0",
    "nock": "^14.0.11",
    "nyc": "^18.0.0",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
